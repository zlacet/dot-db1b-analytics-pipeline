# Copy this file to .env and fill in your own real values.
# .env is gitignored and should never be committed - this file (.env.example)
# is the safe, placeholder version that's fine to commit/share.

# Required only if using --engine claude / SUMMARY_ENGINE=claude in ai_layer/summarize.py
ANTHROPIC_API_KEY=your-key-here

# Makes every pipeline run use Claude to write the narrative summary instead
# of the deterministic template engine. Set to "template" (or remove) to
# use the deterministic engine instead.
SUMMARY_ENGINE=claude

# PostgreSQL connection (defaults shown match pipeline/*.py fallbacks)
PGHOST=localhost
PGPORT=5432
PGDATABASE=airline_fare_variance_platform
PGUSER=your-username
PGPASSWORD=
